# Browser-side (Vite). Optional: the code already defaults to the nors. dataset.
VITE_META_PIXEL_ID=4640251216246898

# Server-side, for api/meta-capi.js. Set these in Vercel -> Settings -> Environment Variables.
# Do NOT prefix them with VITE_ (that would expose them in the browser bundle).
#
# Required. Events Manager -> dataset -> Settings -> Conversions API -> Generate access token.
# META_CAPI_ACCESS_TOKEN=
#
# Optional. Only while testing: events then appear under "Test events" and don't count for ads.
# META_TEST_EVENT_CODE=
